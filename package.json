{
  "name": "bill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:build": "node db/schema.mjs",
    "db:push": "appwrite push table --all --force",
    "db:generate": "appwrite generate --language typescript --output lib/appwrite/generated --appwrite-import-source node-appwrite --enum-style const --import-extension \"\" --server true",
    "db:migrate": "bun run db:build && bun run db:push && bun run db:generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.24",
    "appwrite": "^29.2.0",
    "next": "16.4.5",
    "node-appwrite": "^31.1.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.12",
    "server-only": "^0.0.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
